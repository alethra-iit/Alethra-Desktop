{
  "name": "alethra-browser",
  "productName": "Alethra",
  "version": "1.0.0",
  "description": "Alethra Browser untuk PC (Windows)",
  "main": "src/main/main.js",
  "author": "Alethra",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.alethra.browser.desktop",
    "productName": "Alethra",
    "copyright": "Alethra",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**",
      "!node_modules/sherpa-onnx-linux-*/**",
      "!node_modules/sherpa-onnx-darwin-*/**",
      "!node_modules/sherpa-onnx-win-ia32/**",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**",
      "!node_modules/vosk-koffi/bin-{linux,darwin}-*/**",
      "!node_modules/vosk-koffi/bin-win32-ia32/**"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Alethra",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Alethra-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Alethra-Portable-${version}.${ext}"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/sherpa-onnx-win-x64/**",
      "node_modules/onnxruntime-node/bin/napi-v3/win32/x64/**",
      "node_modules/vosk-koffi/**",
      "node_modules/koffi/**"
    ]
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.13.8",
    "@huggingface/transformers": "^3.8.1",
    "vosk-koffi": "^1.1.1",
    "fflate": "^0.8.2"
  }
}
